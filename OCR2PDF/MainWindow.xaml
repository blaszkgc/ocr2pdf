<Window x:Class="OCR2PDF.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR2PDF" Width="1180" Height="800" MinWidth="820" MinHeight="580" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
        Closing="Window_Closing" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,7"/><Setter Property="MinHeight" Value="34"/><Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <Grid><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            <Border x:Name="FocusRing" BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" BorderThickness="1" CornerRadius="2" Margin="-9,-4" Visibility="Collapsed" IsHitTestVisible="False"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.9"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.75"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="34"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="34"/></Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="5"/><Setter Property="Margin" Value="0,2"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
      <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
      <Style.Triggers>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="False"/></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"/></MultiTrigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/></Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="20" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <TextBlock Text="OCR2PDF" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,24,0"/>
      <Button x:Name="SettingsToggle" DockPanel.Dock="Right" Content="Hide settings" Click="SettingsToggle_Click" Margin="0"/>
      <StackPanel x:Name="CaptureActions" Orientation="Horizontal">
        <Button Content="Capture region" Click="Capture_Click" Style="{StaticResource PrimaryButton}" ToolTip="Capture region (Ctrl+Shift+C)"/>
        <Button Content="Automate…" Click="Automate_Click" ToolTip="Repeat snipping with clicks, scrolling, or a key press"/>
        <Button Content="Import images" Click="Import_Click" ToolTip="Import images (Ctrl+O)"/>
        <Button Content="Paste" Click="Paste_Click" ToolTip="Paste image (Ctrl+V)"/>
      </StackPanel>
    </DockPanel>
    <Grid x:Name="Workspace" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="205" MinWidth="165" MaxWidth="340"/><ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*" MinWidth="200"/><ColumnDefinition x:Name="SettingsDividerColumn" Width="8"/>
        <ColumnDefinition x:Name="SettingsColumn" Width="245" MinWidth="215" MaxWidth="350"/>
      </Grid.ColumnDefinitions>
      <DockPanel>
        <TextBlock x:Name="PageCount" DockPanel.Dock="Top" Text="Pages · 0" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="UpButton" Content="↑" AutomationProperties.Name="Move selected page up" ToolTip="Move up (Alt+Up)" Click="Up_Click" Padding="10,7"/>
            <Button x:Name="DownButton" Content="↓" AutomationProperties.Name="Move selected page down" ToolTip="Move down (Alt+Down)" Click="Down_Click" Padding="10,7"/>
            <Button x:Name="RemoveButton" Content="Remove" Click="Remove_Click" Padding="9,7" ToolTip="Remove selected page (Delete)"/>
          </StackPanel>
          <Button x:Name="UndoButton" Content="Undo remove" Click="Undo_Click" Margin="0,7,0,0" ToolTip="Undo removal (Ctrl+Z)"/>
        </StackPanel>
        <ListBox x:Name="PageList" SelectionChanged="PageList_SelectionChanged" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AllowDrop="True"
                 PreviewMouseLeftButtonDown="PageList_MouseDown" PreviewMouseMove="PageList_MouseMove" DragOver="PageList_DragOver" Drop="PageList_Drop" AutomationProperties.Name="Document pages">
          <ListBox.ItemTemplate><DataTemplate><StackPanel>
            <TextBlock Text="{Binding PageLabel}" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1"><Image Source="{Binding Thumbnail}" Height="98" Stretch="Uniform"/></Border>
            <TextBlock Text="{Binding Name}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
            <TextBlock Text="{Binding Dimensions}" FontSize="11" Margin="0,3,0,0"/>
          </StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
      <DockPanel Grid.Column="2">
        <Grid DockPanel.Dock="Top" Margin="8,0,8,10">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock x:Name="PreviewTitle" Text="PDF page preview" FontWeight="SemiBold" Margin="0,0,0,7"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Content="Fit" Click="Fit_Click" ToolTip="Fit page (Ctrl+0)" Padding="9,5"/>
            <Button Content="−" Click="ZoomOut_Click" AutomationProperties.Name="Zoom out" Padding="9,5"/>
            <Button x:Name="ZoomLabel" Content="100%" Click="ActualSize_Click" ToolTip="Actual page size (Ctrl+1)" Padding="9,5"/>
            <Button Content="+" Click="ZoomIn_Click" AutomationProperties.Name="Zoom in" Padding="9,5" Margin="0"/>
          </StackPanel>
          <TextBlock Grid.Row="1" Text="Ctrl+wheel to zoom · Space+drag to pan" Margin="190,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
        </Grid>
        <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" Background="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}" CornerRadius="5">
          <Grid AllowDrop="True" Drop="Images_Drop" DragOver="Images_DragOver">
            <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="PreviewScroll_SizeChanged"
                          PreviewMouseWheel="PreviewScroll_MouseWheel" PreviewMouseDown="PreviewScroll_MouseDown" PreviewMouseMove="PreviewScroll_MouseMove" PreviewMouseUp="PreviewScroll_MouseUp" LostMouseCapture="PreviewScroll_LostMouseCapture">
              <Canvas x:Name="PageCanvas" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Visibility="Collapsed" ClipToBounds="True">
                <Canvas.LayoutTransform><ScaleTransform x:Name="PageScale" ScaleX="1" ScaleY="1"/></Canvas.LayoutTransform>
                <Image x:Name="Preview" Stretch="Fill" AutomationProperties.Name="Selected page image"/>
              </Canvas>
            </ScrollViewer>
            <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="250">
              <TextBlock Text="Start your document" FontSize="19" FontWeight="SemiBold" TextAlignment="Center"/>
              <TextBlock Text="Capture a region, paste an image, or drop image files here." TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
      </DockPanel>
      <GridSplitter x:Name="SettingsDivider" Grid.Column="3" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
      <ScrollViewer x:Name="SettingsPane" Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="SettingsPanel" Margin="12,0,0,0">
          <TextBlock Text="Export settings" FontWeight="SemiBold" Margin="0,0,0,16"/>
          <Label Content="Page size" Target="{Binding ElementName=PageSize}" Padding="0,0,0,6"/>
          <ComboBox x:Name="PageSize" SelectedIndex="0" SelectionChanged="PageSetting_Changed" AutomationProperties.Name="PDF page size"><ComboBoxItem Content="Letter (8.5 × 11 in)"/><ComboBoxItem Content="A4"/></ComboBox>
          <Label Content="Orientation" Target="{Binding ElementName=Orientation}" Margin="0,14,0,0" Padding="0,0,0,6"/>
          <ComboBox x:Name="Orientation" SelectedIndex="0" SelectionChanged="PageSetting_Changed" AutomationProperties.Name="PDF orientation"><ComboBoxItem Content="Portrait"/><ComboBoxItem Content="Landscape"/></ComboBox>
          <CheckBox x:Name="WriteText" Content="Also save plain text (.txt)" IsChecked="True" Margin="0,18,0,18"/>
          <TextBlock Text="Text recognition languages" Margin="0,0,0,6"/>
          <ListBox x:Name="Languages" Height="115" SelectionMode="Multiple" SelectionChanged="Languages_Changed" AutomationProperties.Name="Installed OCR languages">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}" Padding="3"/></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="OcrStatus" Text="Checking text recognition…" TextWrapping="Wrap" Margin="0,8,0,14"/>
          <Expander x:Name="AdvancedSettings" Header="Advanced">
            <StackPanel Margin="0,10,0,0">
              <Label Content="Tesseract executable" Target="{Binding ElementName=TesseractPath}" Padding="0,0,0,6"/>
              <TextBox x:Name="TesseractPath" TextWrapping="Wrap" AutomationProperties.Name="Tesseract executable path" TextChanged="TesseractPath_Changed"/>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="Browse…" Click="Browse_Click"/><Button Content="Refresh" Click="RefreshLanguages_Click"/></StackPanel>
            </StackPanel>
          </Expander>
          <TextBlock Text="Images keep their resolution and proportions. Recognition runs locally." TextWrapping="Wrap" Margin="0,20,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <StackPanel Grid.Row="2" Margin="0,14,0,0">
      <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="100" Visibility="Collapsed" AutomationProperties.Name="Operation progress"/>
      <DockPanel Margin="0,10,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="OpenPdfButton" Content="Open PDF" Click="OpenPdf_Click" Visibility="Collapsed"/>
          <Button x:Name="OpenFolderButton" Content="Open folder" Click="OpenFolder_Click" Visibility="Collapsed"/>
          <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed"/>
          <Button x:Name="ExportButton" Content="Export PDF" Click="Export_Click" Style="{StaticResource PrimaryButton}" Margin="0" IsEnabled="False" ToolTip="Export searchable PDF (Ctrl+E)"/>
        </StackPanel>
        <TextBlock x:Name="Status" Text="Add images to begin." VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite"/>
      </DockPanel>
    </StackPanel>
  </Grid>
</Window>
